{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "outDir": "dist/cjs",
    "paths": {
      "#sync-require": ["./src/shared/require-sync-cjs.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/shared/require-sync-esm.ts"]
}
